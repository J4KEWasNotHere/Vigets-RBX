										<string name="Name">captureDependencies</string>
										<int64 name="SourceAssetId">-1</int64>
										<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
										<UniqueId name="UniqueId">132e18f07c5ed51c0a7957c30000243a</UniqueId>
									</Properties>
