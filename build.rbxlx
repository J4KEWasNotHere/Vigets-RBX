						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local action = require "./action"()
local cleanup = require "./cleanup"

local function changed<T>(property: string, callback: (T) -> ())
    return action(function(instance)
        local con = instance:GetPropertyChangedSignal(property):Connect(function()
            callback((instance :: any)[property])
        end)

        cleanup(function()
            con:Disconnect()
        end)

        callback((instance :: any)[property])
    end)
end

return changed
]]></ProtectedString>
						<string name="ScriptGuid">{43B6853D-CB48-4099-A699-8B20D56FD01C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
